# Copy to .env (or .env.local) and fill in real values. Never commit .env.

# Postgres connection string (e.g. Neon pooled URL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Root domain that school subdomains hang off, e.g. myschoolapp.com
ROOT_DOMAIN="localhost:3000"

# Paystack secret key (test_ or live_ prefixed). Used for fee payments + webhooks.
PAYSTACK_SECRET_KEY=""

# Platform super-admin credentials (created by seed script)
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
